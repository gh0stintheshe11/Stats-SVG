# Fail the commit if package.json and the code disagree about dependencies.
# This only reports; it never changes package.json or stages files for you.
npm run --silent check:deps || {
  echo "Dependency check failed (see above). Remove unused packages with 'npm uninstall <name>', add missing ones with 'npm install <name>', or commit with --no-verify if this is a false positive."
  exit 1
}
