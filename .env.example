# Copy this file to .env for local development (npm start). On Vercel, set these in
# Project Settings → Environment Variables instead. Never commit your real .env.

# Required for /api/github-status. A classic token with no scopes is enough for public data;
# see the README for when you might want the `repo` scope.
GITHUB_TOKEN=

# Required for /api/steam-status. Get one at https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Optional. Comma-separated usernames this instance will serve; everyone else gets a 403.
ALLOWED_USERNAMES=

# Optional. Port for the local dev server (default 3000).
PORT=
