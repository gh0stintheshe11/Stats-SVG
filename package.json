{
  "name": "github-stats-svg",
  "version": "1.0.0",
  "private": true,
  "description": "Animated, cyberpunk-styled SVG stats cards for GitHub profiles",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node scripts/dev-server.js",
    "test": "node --test test/*.test.js",
    "test:update-snapshots": "UPDATE_SNAPSHOTS=1 node --test test/*.test.js",
    "build:fonts": "node scripts/build-fonts.js",
    "build:language-aliases": "node scripts/build-language-aliases.js",
    "check:deps": "knip --dependencies",
    "prepare": "husky"
  },
  "dependencies": {
    "@vercel/functions": "^3.11.3",
    "image-size": "^2.1.0"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "knip": "^6.48.0",
    "subset-font": "^2.9.0",
    "yaml": "^2.9.1"
  }
}
